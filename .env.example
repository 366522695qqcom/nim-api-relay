# 上游 API 地址（默认 https://integrate.api.nvidia.com）
UPSTREAM_URL=https://integrate.api.nvidia.com

# 本地运行端口（默认 8080）
PORT=8080

# 管理面板统计持久化（Vercel KV / Upstash Redis）。未配置则以进程内存降级。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 可选：访问 /admin 管理面板所需的密码（URL 后追加 ?token=密码）
# ADMIN_PASSWORD=

# 可选：转发前额外剔除的请求体字段（逗号分隔）。
# 适用场景：客户端会携带上游不支持的字段导致 400（如 Kimi Code），
# 你可在此列出需要剔除的顶层字段名。默认已处理 stream_options 组合问题。
# STRIP_FIELDS=metadata,custom_field

# 上游 API 地址（默认 https://integrate.api.nvidia.com）
UPSTREAM_URL=https://integrate.api.nvidia.com

# 本地运行端口（默认 8080）
PORT=8080

# 管理面板统计持久化（Vercel KV / Upstash Redis）。未配置则以进程内存降级。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 模型名映射：客户端发 Claude Code 的 claude-*，转发时替换成上游 NIM 模型。
# 格式为逗号分隔的 from=to；未命中的 claude-* 使用 DEFAULT_MODEL。
# MODEL_MAP=claude-opus-4-5=mistralai/mistral-large-4-1t-a52b,claude-sonnet-4-5=nvidia/nemotron-3-ultra-550b-a55b
# DEFAULT_MODEL=nvidia/nemotron-3.5-bolt-e4b

# 可选：访问 /admin 管理面板所需的密码（URL 后追加 ?token=密码）
# ADMIN_PASSWORD=
